# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gruha Alankara - Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this to .env and fill in your values

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-string

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=gruha_alankara

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIR=./data/chromadb

# --- DeepSeek API (Supervisor + Critic) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner

# --- Groq API ---
GROQ_API_KEY=your-groq-api-key
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vision Model Endpoints ---
FLORENCE2_ENDPOINT=http://localhost:8001/v1/vision/florence2
YOLOV11_ENDPOINT=http://localhost:8002/v1/vision/yolo
SAM2_ENDPOINT=http://localhost:8003/v1/vision/sam2

# --- Voice ---
WHISPER_MODEL_SIZE=large-v3
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Server ---
HOST=0.0.0.0
PORT=5000
WORKERS=4

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Add your production frontend URL here when deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
